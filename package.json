{
  "name": "itslouis-dev",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.22.1",
      "onFail": "warn"
    }
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "party:dev": "wrangler dev --config party/wrangler.jsonc",
    "party:deploy": "wrangler deploy --config party/wrangler.jsonc"
  },
  "dependencies": {
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/content": "3.16.2",
    "@nuxt/ui": "^4.12.0",
    "@takumi-rs/core": "2.18.1",
    "@takumi-rs/wasm": "2.18.1",
    "nuxt": "^4.6.2",
    "nuxt-og-image": "7.0.7",
    "nuxt-security": "2.7.0",
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "ufo": "^1.6.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@cloudflare/workers-types": "^5.20261026.1",
    "@iconify-json/carbon": "^1.2.29",
    "@iconify-json/lucide": "^1.2.147",
    "@iconify-json/simple-icons": "^1.2.100",
    "@iconify-json/vscode-icons": "^1.2.93",
    "@nuxt/eslint": "^1.17.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.152.0"
  }
}
