{
  "name": "itslouis-dev",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.20.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "party:dev": "wrangler dev --config party/wrangler.jsonc",
    "party:deploy": "wrangler deploy --config party/wrangler.jsonc"
  },
  "dependencies": {
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/content": "3.16.0",
    "@nuxt/ui": "^4.11.1",
    "@takumi-rs/core": "2.14.0",
    "@takumi-rs/wasm": "2.14.0",
    "nuxt": "^4.5.2",
    "nuxt-og-image": "6.8.0",
    "nuxt-security": "2.6.0",
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "ufo": "^1.6.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@cloudflare/workers-types": "^5.20260921.1",
    "@iconify-json/carbon": "^1.2.27",
    "@iconify-json/lucide": "^1.2.135",
    "@iconify-json/simple-icons": "^1.2.97",
    "@iconify-json/vscode-icons": "^1.2.79",
    "@nuxt/eslint": "^1.17.0",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.135.0"
  }
}
